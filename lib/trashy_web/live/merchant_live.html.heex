<div class="mx-auto max-w-5xl px-4 pb-24 sm:px-6">
  <%!-- ─────────────────────────── No event ─────────────────────────── --%>

  <div :if={is_nil(@event)} class="mt-24 text-center">
    <p class="text-4xl">🧹</p>
    <h1 class="mt-4 text-xl font-semibold text-stone-800">
      No cleanup scheduled right now
    </h1>
    <p class="mx-auto mt-2 max-w-sm text-sm text-stone-500">
      Orders show up here automatically once an event is underway.
      You can leave this page open.
    </p>
    <p class="mt-6 text-xs text-stone-300">
      Last checked <%= Calendar.strftime(@now, "%-I:%M %p") %>
    </p>
  </div>

  <%!-- ─────────────────────────── Live event ────────────────────────── --%>

  <div :if={@event}>
    <div class="sticky top-0 z-10 -mx-4 border-b border-stone-200 bg-stone-50/95 px-4 py-4 backdrop-blur sm:-mx-6 sm:px-6">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <div class="min-w-0">
          <h1 class="truncate text-2xl font-semibold tracking-tight text-stone-900">
            <%= @cleanup.neighborhood %>
          </h1>
          <p class="mt-0.5 truncate text-sm text-stone-500">
            <%= @cleanup.location %>
            <span class="text-stone-300">·</span>
            <%= Calendar.strftime(@event.time, "%a %b %-d, %-I:%M %p") %>
          </p>
        </div>

        <div class="flex items-center gap-2">
          <div class="rounded-xl bg-amber-100 px-3 py-1.5 text-center">
            <div class="text-xl font-bold leading-none tabular-nums text-amber-900">
              <%= @pending_count %>
            </div>
            <div class="mt-0.5 text-[10px] font-medium uppercase tracking-wide text-amber-700">
              Open
            </div>
          </div>
          <div class="rounded-xl bg-stone-100 px-3 py-1.5 text-center">
            <div class="text-xl font-bold leading-none tabular-nums text-stone-700">
              <%= @done_count %>
            </div>
            <div class="mt-0.5 text-[10px] font-medium uppercase tracking-wide text-stone-500">
              Done
            </div>
          </div>
          <div class="rounded-xl bg-stone-100 px-3 py-1.5 text-center">
            <div class="text-xl font-bold leading-none tabular-nums text-stone-700">
              <%= @participant_count %>
            </div>
            <div class="mt-0.5 text-[10px] font-medium uppercase tracking-wide text-stone-500">
              Cleanup volunteers
            </div>
          </div>
        </div>
      </div>
    </div>

    <%!-- Running tally of what still needs making --%>
    <div :if={@tally != []} class="mt-6 flex flex-wrap gap-2">
      <span
        :for={item <- @tally}
        class="inline-flex items-center gap-2 rounded-full border border-stone-200 bg-white px-3 py-1.5 text-sm text-stone-700 shadow-sm"
      >
        <span class="text-base"><%= item.icon %></span>
        <span class="font-medium"><%= item.label %></span>
        <span class="rounded-full bg-stone-900 px-1.5 py-0.5 text-xs font-bold tabular-nums text-white">
          <%= item.count %>
        </span>
      </span>
    </div>

    <%!-- Open orders --%>
    <h2 class="mt-8 text-xs font-semibold uppercase tracking-widest text-stone-400">
      Open orders <span class="text-stone-300">— tap to complete</span>
    </h2>

    <div
      :if={@pending_count == 0}
      class="mt-4 rounded-2xl border-2 border-dashed border-stone-200 py-16 text-center"
    >
      <p class="text-3xl">☕</p>
      <p class="mt-2 font-medium text-stone-600">All caught up</p>
      <p class="mt-1 text-sm text-stone-400">New orders appear here automatically.</p>
    </div>

<div :if={@event} id="pending-orders" phx-update="stream" class="mt-4 grid gap-3 sm:grid-cols-2">
      <button
        :for={{dom_id, order} <- @streams.pending}
        id={dom_id}
        phx-click="toggle_complete"
        phx-value-id={order.id}
        class="group relative overflow-hidden rounded-2xl border border-stone-200 bg-white p-4 text-left shadow-sm transition
               hover:border-amber-300 hover:shadow-md active:scale-[0.98] active:bg-amber-50
               focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-400 focus-visible:ring-offset-2"
      >
        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0">
            <p class="truncate text-base font-semibold text-stone-900">
              <%= order.event_participant.first_name %> <%= order.event_participant.last_name %>
            </p>
            <p class="mt-0.5 truncate text-xs text-stone-500">
              <%= order.promotion.icon %> <%= order.promotion.merchant %>
            </p>
          </div>
          <span class={[
            "shrink-0 text-xs font-medium tabular-nums",
            urgency(minutes_waiting(order.claimed_at, @now))
          ]}>
            <%= waited(order.claimed_at, @now) %>
          </span>
        </div>

        <p class="mt-3 text-lg font-medium leading-snug text-stone-800">
          <%= order_label(order) %>
        </p>

        <p
          :if={order.notes not in [nil, ""]}
          class="mt-2 rounded-lg bg-amber-50 px-2.5 py-1.5 text-sm text-amber-900"
        >
          <%= order.notes %>
        </p>

        <span class="pointer-events-none absolute inset-x-0 bottom-0 h-1 bg-amber-400 opacity-0 transition-opacity group-hover:opacity-100" />
      </button>
    </div>

    <%!-- Completed, collapsed --%>
    <details :if={@done_count > 0} class="group mt-10">
      <summary class="cursor-pointer list-none text-xs font-semibold uppercase tracking-widest text-stone-400 hover:text-stone-600">
        Completed (<%= @done_count %>)
        <span class="ml-1 inline-block transition group-open:rotate-90">›</span>
      </summary>

<div :if={@event} id="done-orders" phx-update="stream" class="mt-3 divide-y divide-stone-100 overflow-hidden rounded-2xl border border-stone-200 bg-white">
        <button
          :for={{dom_id, order} <- @streams.done}
          id={dom_id}
          phx-click="toggle_complete"
          phx-value-id={order.id}
          class="flex w-full items-center gap-3 px-4 py-2.5 text-left hover:bg-stone-50
                 focus:outline-none focus-visible:bg-stone-50"
        >
          <span class="shrink-0 text-emerald-500">✓</span>
          <span class="w-40 shrink-0 truncate text-sm text-stone-500">
            <%= order.event_participant.first_name %> <%= order.event_participant.last_name %>
          </span>
          <span class="truncate text-sm text-stone-400 line-through">
            <%= order_label(order) %>
          </span>
          <span class="ml-auto shrink-0 text-[11px] uppercase tracking-wide text-stone-300">
            undo
          </span>
        </button>
      </div>
    </details>

    <p class="mt-10 text-center text-xs text-stone-300">
      Updating live · last checked <%= Calendar.strftime(@now, "%-I:%M %p") %>
    </p>
  </div>
</div>
