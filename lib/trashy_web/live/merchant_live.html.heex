<div class="mx-auto max-w-5xl px-4 pb-16 sm:px-6">
  <%!-- ─────────────────────────── No event ─────────────────────────── --%>

  <div :if={is_nil(@event)} class="mt-24 text-center">
    <p class="text-4xl">🧹</p>
    <h1 class="mt-4 text-xl font-semibold text-stone-800">
      No cleanup scheduled right now
    </h1>
    <p class="mx-auto mt-2 max-w-sm text-sm text-stone-500">
      Orders show up here automatically once an event is underway.
      You can leave this page open.
    </p>
    <p class="mt-6 text-xs text-stone-300">
      Last checked <%= Calendar.strftime(@now, "%-I:%M %p") %>
    </p>
  </div>

  <%!-- ─────────────────────────── Live event ────────────────────────── --%>

  <div :if={@event}>
    <div class="sticky top-0 z-10 -mx-4 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 border-b border-stone-200 bg-stone-50/95 px-4 py-2.5 backdrop-blur sm:-mx-6 sm:px-6">
      <h1 class="min-w-0 truncate text-lg font-semibold leading-tight tracking-tight text-stone-900">
        <%= @cleanup.neighborhood %>
        <span class="ml-1 text-sm font-normal text-stone-500">
          <%= Calendar.strftime(@event.time, "%a %b %-d, %-I:%M %p") %>
        </span>
      </h1>

      <div class="flex shrink-0 items-baseline gap-4">
        <span class="tabular-nums">
          <span class="text-base font-bold text-amber-900"><%= @pending_count %></span>
          <span class="text-[10px] uppercase tracking-wide text-stone-500">open</span>
        </span>
        <span class="tabular-nums">
          <span class="text-base font-bold text-stone-700"><%= @done_count %></span>
          <span class="text-[10px] uppercase tracking-wide text-stone-500">done</span>
        </span>
        <span class="tabular-nums">
          <span class="text-base font-bold text-stone-700"><%= @participant_count %></span>
          <span class="text-[10px] uppercase tracking-wide text-stone-500">volunteers</span>
        </span>
      </div>
    </div>

    <div
      :if={@rows == []}
      class="mt-10 rounded-xl border border-dashed border-stone-200 py-12 text-center"
    >
      <p class="text-2xl">☕</p>
      <p class="mt-1 text-sm text-stone-500">No orders yet — they show up here on their own.</p>
    </div>

    <table :if={@rows != []} class="mt-4 w-full table-fixed border-collapse text-sm">
      <thead>
        <tr class="border-b border-stone-200 text-left text-[10px] uppercase tracking-widest text-stone-400">
          <th class="w-10 py-1.5 pl-1 font-semibold">Done</th>
          <th class="py-1.5 pr-3 font-semibold">Order</th>
          <th class="w-1/4 py-1.5 pr-3 font-semibold">Notes</th>
          <th class="w-36 py-1.5 pr-3 font-semibold">Volunteer</th>
          <th class="w-16 py-1.5 pr-1 text-right font-semibold">Wait</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-stone-100">
        <tr
          :for={order <- @rows}
          id={"order-#{order.id}"}
          role="button"
          tabindex="0"
          aria-pressed={to_string(order.completed)}
          phx-click="toggle_complete"
          phx-value-id={order.id}
          phx-keydown="toggle_complete"
          phx-key="Enter"
          class={[
            "group cursor-pointer align-top transition-colors focus:outline-none",
            if(order.completed,
              do: "bg-stone-50 text-stone-400 hover:bg-stone-100 focus-visible:bg-stone-100",
              else: "text-stone-800 hover:bg-amber-50 focus-visible:bg-amber-50"
            )
          ]}
        >
          <td class="py-1 pl-1">
            <span
              aria-hidden="true"
              class={[
                "flex h-5 w-5 items-center justify-center rounded border text-xs leading-none transition",
                if(order.completed,
                  do: "border-emerald-500 bg-emerald-500 text-white",
                  else: "border-stone-300 bg-white text-transparent group-hover:border-amber-400"
                )
              ]}
            >
              ✓
            </span>
          </td>

          <td class={["py-1 pr-3 leading-snug", order.completed && "line-through"]}>
            <span class="mr-1"><%= order.promotion.icon %></span>
            <span class="font-medium"><%= order_label(order) %></span>
          </td>

          <td class={[
            "py-1 pr-3 leading-snug",
            if(order.completed, do: "line-through", else: "text-stone-500")
          ]}>
            <%= order.notes %>
          </td>

          <td class="truncate py-1 pr-3 leading-snug">
            <%= participant_name(order) %>
          </td>

          <td class={[
            "py-1 pr-1 text-right text-xs font-medium tabular-nums leading-snug",
            urgency(order, @now)
          ]}>
            <%= waited(order.claimed_at, @now) %>
          </td>
        </tr>
      </tbody>
    </table>

    <p class="mt-8 text-center text-xs text-stone-300">
      Updating live · last checked
      <span id="last-checked" phx-hook="LocalTime" data-utc={DateTime.to_iso8601(@now)}>
        <%= Calendar.strftime(@now, "%-I:%M %p") %> UTC
      </span>
    </p>
  </div>
</div>
